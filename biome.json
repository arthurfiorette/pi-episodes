{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "extends": ["@arthurfiorette/biomejs-config"],
  "assist": {
    "actions": {
      "source": {
        "useSortedPackageJson": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "bracketSpacing": true
    }
  },
  "overrides": [
    {
      "includes": [
        "bench/scenarios/**/variants/**",
        "bench/scenarios/**/fixtures/**",
        "bench/scenarios/**/reference/**",
        "bench/test/fixtures/**"
      ],
      "formatter": { "enabled": false },
      "linter": { "enabled": false },
      "assist": { "enabled": false }
    }
  ]
}

{
  "name": "pi-episodes",
  "version": "0.3.0",
  "description": "Fold finished episodes out of pi's context, and recall, ask or fork them instead of compacting",
  "keywords": [
    "pi-package",
    "pi",
    "agent",
    "context",
    "compaction",
    "fork"
  ],
  "homepage": "https://github.com/arthurfiorette/pi-episodes#readme",
  "bugs": {
    "url": "https://github.com/arthurfiorette/pi-episodes/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurfiorette/pi-episodes.git"
  },
  "funding": "https://github.com/arthurfiorette/pi-episodes?sponsor=1",
  "license": "MIT",
  "author": "Arthur Fiorette <me@arthur.place>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stats": {
      "types": "./dist/stats.d.ts",
      "import": "./dist/stats.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint-ci": "biome ci .",
    "lint-fix": "biome check --write --unsafe .",
    "prepack": "pnpm build",
    "test": "tsx --test test/*.test.ts",
    "test-types": "tsc --noEmit"
  },
  "dependencies": {
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@arthurfiorette/biomejs-config": "^2.0.1",
    "@biomejs/biome": "^2.5.15",
    "@earendil-works/pi-agent-core": "^1.1.0",
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typebox": "^1.3.27",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.16"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": ">=24.16"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
